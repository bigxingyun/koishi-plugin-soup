{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bigxingyun/koishi-plugin-soup/schema/layout-plan.schema.json",
  "title": "LayoutPlan / 报纸版面规划",
  "description": "AI 只能产出这个结构；排版由 build.py 确定性地算。所有字段都有硬上限，越界会被夹紧并记 WARN。",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "body"],
  "properties": {
    "version": { "const": 1 },
    "masthead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 6 },
        "en": { "type": "string", "maxLength": 40 }
      }
    },
    "issue": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "pages": { "type": "integer", "minimum": 1, "maximum": 9 },
    "date": { "type": "string", "format": "date" },
    "difficulty": { "type": "string", "maxLength": 8 },
    "tags": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 8 }
    },
    "kicker": {
      "type": "string",
      "maxLength": 18,
      "description": "引题。六个字到十几个字最好，别复述汤面，要制造悬念"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 14 },
    "deck": {
      "type": "string",
      "maxLength": 48,
      "description": "副题。一句话交代冲突，但不能说出答案"
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 1200 },
      "description": "汤面段落。只能改写措辞与分段，不得增加原文没有的事实"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": { "enum": [1, 2] },
        "fontPx": { "type": "number", "minimum": 12, "maximum": 16.5 },
        "lineHeight": { "type": "number", "minimum": 1.65, "maximum": 2.1 },
        "dropCap": { "type": "boolean" },
        "accent": {
          "enum": ["rust", "blood", "ink", "steel"],
          "description": "rust=铁锈红（社会派/日常） blood=暗红（恐怖/血腥） ink=墨黑（本格/冷案） steel=钢蓝（刑侦/悬疑）"
        },
        "grain": { "type": "number", "minimum": 0.3, "maximum": 1.0 }
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 2, "maxLength": 4 },
        "angle": { "type": "number", "minimum": -12, "maximum": 0 },
        "opacity": { "type": "number", "minimum": 0.35, "maximum": 0.75 }
      }
    },
    "byline": { "type": "string", "maxLength": 40 },
    "dateline": { "type": "string", "maxLength": 30 },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 6 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 44 } }
      }
    },
    "howto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 6 },
        "lines": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 44 } }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": { "type": "string", "maxLength": 40 },
        "right": { "type": "string", "maxLength": 12 }
      }
    }
  }
}
